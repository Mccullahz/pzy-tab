# PZY-Tab deployment config. Copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is gitignored. Everything here is OPTIONAL: with none of it set, PZY-Tab
# runs standalone as roaster software and never talks to anyone's storefront.

# --- Fulfillment sync (docs/SYNC.md) ------------------------------------
# Sync turns on only when BOTH secrets below are present. Generate each with:
#
#   openssl rand -hex 32
#
# SYNC_AUTH_TOKEN is the shared bearer token. It MUST be the same value as the
# storefront's FULFILLMENT_SYNC_SECRET -- that pairing is what authorizes this
# roaster to talk to that store, and it is issued by the store's operator.
SYNC_AUTH_TOKEN=

# SYNC_SIGNING_SECRET keys the HMAC-SHA256 signature over request bodies.
# Required for sync to enable at all. We verify it on every inbound /sync
# request, so a peer that polls our feed must sign with the same value -- on the
# PZY storefront that is FULFILLMENT_SYNC_SIGNING_SECRET. (Its own inbound side
# is bearer-only and ignores the signature we send.)
SYNC_SIGNING_SECRET=

# Base URL of the storefront's sync API. Empty = inbound-only (we accept sync
# but never reach out, and no orders ever reach the board). host.docker.internal
# resolves to the docker host, which is how this container reaches a storefront
# running in its own compose project on the same machine -- see extra_hosts in
# docker-compose.yml.
#   same machine:  http://host.docker.internal:8080
#   another box:   http://store.example.com
SYNC_PEER_URL=http://host.docker.internal:8080
